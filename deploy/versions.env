# Pinned versions of everything install.sh downloads. Bump these on purpose, test on staging, then ship.
# (Previously install.sh cloned the latest Supabase docker setup on every run — an upgrade nobody asked for.)

# supabase/supabase git commit whose docker/ folder is used (its docker-compose.yml pins every Supabase image)
#   https://github.com/supabase/supabase/commits/master/docker — tested 2026-10-10
SUPABASE_REF=8617532ae1a41571d5d557cd24c6f5f2565d9230

# reverse proxy
CADDY_IMAGE=caddy:2.10.2-alpine

# helper container that calls /api/cron
CRON_IMAGE=alpine:3.20
