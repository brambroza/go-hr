# deploy/install.sh copies this to deploy/backup.env (chmod 600) and schedules deploy/backup.sh every night at 01:30
# (/etc/cron.d/gohr-backup). Fill in the off-site target and the passphrase before handover.
# Read by deploy/backup.sh and deploy/restore.sh.

# local copies (kept KEEP_DAYS days)
BACKUP_DIR=/var/backups/gohr
KEEP_DAYS=30

# REQUIRED before handover: a copy outside this server. One of
#   rclone:<remote>:<path>   e.g. rclone:gohr-s3:customer-backups/gohr   (run `rclone config` first)
#   <user>@<host>:<path>     rsync over SSH with a key, e.g. backup@nas.local:/volume1/gohr
#   /mnt/<path>              a mounted NAS / USB disk
BACKUP_OFFSITE=

# encrypt backups before they leave the server (recommended for cloud targets).
# Create with: openssl rand -base64 48 > /root/gohr-backup.pass && chmod 600 /root/gohr-backup.pass
# The passphrase file is NOT part of any backup. Keep two copies away from this server — one with the customer's
# IT owner, one in GoAlong's password vault — and write down where in the handover document. Without it the
# backups cannot be restored by anyone.
# Without a passphrase the configuration archive (config-<stamp>.tgz: .env files with every secret of this
# install) is kept on this server only and is not copied off-site.
BACKUP_PASSPHRASE_FILE=

# POST target when a backup fails (optional)
BACKUP_NOTIFY_URL=
