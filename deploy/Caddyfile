# GOHR_DOMAIN: a public domain (automatic Let's Encrypt certificate), e.g. hr.company.co.th
#              or an IP / LAN name — then TLS_MODE=internal issues a self-signed certificate
{$GOHR_DOMAIN} {
	tls {$TLS_MODE:internal}
	encode zstd gzip

	# Auth service: the browser only needs "who am I", session refresh and sign-out.
	# Sign-in and password changes go through the app's server actions, which enforce the lockout, the per-IP
	# throttle and the password policy and reach the auth service inside the docker network (http://kong:8000).
	# Everything else on /auth/v1 (password grant, sign-up, recovery, OTP, PUT /user, admin) is closed from outside —
	# otherwise the lockout can be bypassed by calling the auth service directly.
	@auth_closed {
		path /auth/v1/*
		not {
			method GET
			path /auth/v1/user
		}
		not {
			method POST
			path /auth/v1/token
			query grant_type=refresh_token
		}
		not {
			method POST
			path /auth/v1/logout
		}
	}
	handle @auth_closed {
		respond 404
	}

	# Supabase API on the same origin (no CORS, one certificate)
	@supabase path /auth/v1/* /rest/v1/* /storage/v1/* /realtime/v1/*
	handle @supabase {
		reverse_proxy kong:8000
	}

	handle {
		reverse_proxy app:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(self)"
	}
}
