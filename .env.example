# ---------------------------------------------------------------------------
# GO HR environment. Production (docker) values are written by deploy/install.sh into deploy/.env
# For local development copy to .env.local
# ---------------------------------------------------------------------------

# URL the BROWSER uses to reach Supabase (in production: the same https origin as the app — Caddy routes /auth/v1, /rest/v1, /storage/v1)
PUBLIC_SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
# URL the Next.js SERVER uses to reach Supabase (inside docker: http://kong:8000)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

APP_URL=http://localhost:3000
# shared secret for /api/cron (the cron container calls it every minute)
CRON_SECRET=change-me
# optional: license string (otherwise paste it in Settings → License)
GOHR_LICENSE=

# (dev only — older names still accepted)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Free-trial sign-up page /trial — ONLY on GoAlong's own demo server. Leave unset on customer installs.
# ---------------------------------------------------------------------------
# TRIAL_SIGNUP=1
# Cloudflare Turnstile keys (dash.cloudflare.com → Turnstile → add site). Without the secret the form refuses sign-ups.
# Test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Set to 1 only when the app is reachable ONLY through the Cloudflare proxy (then CF-Connecting-IP is trusted)
# TRUST_CLOUDFLARE=
# LINE group / user id that receives each new lead (uses the LINE OA token from Settings → Automation)
# TRIAL_NOTIFY_LINE_TO=
# LINE OA shown on the page, e.g. @goalong
# TRIAL_CONTACT_LINE=
# Demo logins shown after sign-up (JSON). Use sandbox accounts only — the demo DB must be reset nightly.
# TRIAL_DEMO_ACCOUNTS=[{"label":"ฝ่ายบุคคล (HR)","login":"hr","password":"...","path":"/dashboard"},{"label":"พนักงาน (มือถือ)","login":"E0011","password":"...","path":"/m"}]
