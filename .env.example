# --- Supabase (self-hosted on the customer's server, or Supabase Cloud) ---
# URL the browser uses to reach Supabase (Kong gateway)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL the Next.js server uses (inside docker network it can be http://kong:8000)
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_URL=http://localhost:3000
# shared secret for /api/cron (scheduler container calls it every minute)
CRON_SECRET=change-me
# license file content (or put it in Settings → License)
GOHR_LICENSE=

# --- Optional integrations ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
SMTP_URL=
